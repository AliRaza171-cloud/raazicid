# Copy this file to .env and fill in your values. Never commit .env.

# Neon -> your project -> Connection string. Change "postgresql://" to "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/raazicid?sslmode=require

JWT_SECRET=put-a-long-random-string-here
CORS_ORIGINS=http://localhost:5173

# Cloudinary (free account) -> Dashboard -> API Keys. Needed for rider documents and photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI for rider document review, the disaster news scan and the need finder. Pick one provider:
AI_PROVIDER=openai          # openai or claude
OPENAI_API_KEY=             # platform.openai.com > API keys
OPENAI_MODEL=gpt-5.5        # must support web search and images
ANTHROPIC_API_KEY=          # console.anthropic.com (only if AI_PROVIDER=claude)
CLAUDE_MODEL=claude-sonnet-5-5

# Photo classifier files (raazicid_classifier.pt + labels.json), see ml/README.md
CLASSIFIER_DIR=models

# Phase 6: data sources (fetched automatically while the backend runs)
ENABLE_SCHEDULER=true
HDX_EMAIL=                 # your email, needed by HDX HAPI (IPC food insecurity, food prices, poverty)
WEB_SCAN_EVERY_HOURS=0     # Claude web scan for new disasters; 0 = only from the admin button (each scan costs a few cents)
RELIEFWEB_APPNAME=         # after ReliefWeb approves your appname (apidoc.reliefweb.int)
HDX_APP_IDENTIFIER=        # optional, made from HDX_EMAIL if empty
GOOGLE_MAPS_API_KEY=

# Phase 6B: report library and need finder
ENABLE_EMBEDDINGS=true     # needs: pip install sentence-transformers (downloads a ~470 MB model once). false = keyword search only
NEED_DATA_MAX_YEARS=2       # need levels ignore data older than this (Pakistan's poverty survey is from 2018)
