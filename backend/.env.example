# Copy this file to .env and fill in your values. Never commit .env.

# Neon -> your project -> Connection string. Change "postgresql://" to "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/raazicid?sslmode=require

JWT_SECRET=put-a-long-random-string-here
CORS_ORIGINS=http://localhost:5173

# Cloudinary (free account) -> Dashboard -> API Keys. Needed for rider documents and photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Claude API key (console.anthropic.com) for AI rider document review (Phase 5) and the RAG (Phase 6)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Photo classifier files (raazicid_classifier.pt + labels.json), see ml/README.md
CLASSIFIER_DIR=models

# Phase 6: data sources (fetched automatically while the backend runs)
ENABLE_SCHEDULER=true
HDX_EMAIL=                 # your email, needed by HDX HAPI (IPC food insecurity, food prices, poverty)
WEB_SCAN_EVERY_HOURS=0     # Claude web scan for new disasters; 0 = only from the admin button (each scan costs a few cents)
RELIEFWEB_APPNAME=         # after ReliefWeb approves your appname (apidoc.reliefweb.int)
HDX_APP_IDENTIFIER=        # optional, made from HDX_EMAIL if empty
GOOGLE_MAPS_API_KEY=
