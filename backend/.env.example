# Copy this file to .env and fill in your values. Never commit .env.

# Neon -> your project -> Connection string. Change "postgresql://" to "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/raazicid?sslmode=require

JWT_SECRET=put-a-long-random-string-here
CORS_ORIGINS=http://localhost:5173

# Cloudinary (free account) -> Dashboard -> API Keys. Needed for rider documents and photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Filled in later phases
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
RELIEFWEB_APPNAME=
HDX_APP_IDENTIFIER=
